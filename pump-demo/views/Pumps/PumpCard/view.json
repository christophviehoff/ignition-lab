                      "type": "expression",
                      "expression": "case({value}, \"OK\", \"#8fd6ad\", \"WARN\", \"#f5d27a\", \"ALARM\", \"#f0a6a6\", \"TRIPPED\", \"#d9534f\", \"STOPPED\", \"#dcdcdc\", \"#dcdcdc\")"
