# ignition-lab settings
# Lab credentials only. Never reuse these outside this machine.

TZ=America/Los_Angeles

# ---- Ignition ----------------------------------------------------
IGNITION_VERSION=8.3.9
GATEWAY_NAME=ignition-lab
IGNITION_ADMIN_USER=admin
IGNITION_ADMIN_PASSWORD=change-me
IGNITION_HTTP_PORT=8088
IGNITION_HTTPS_PORT=8043
IGNITION_INIT_MEMORY=512
IGNITION_MAX_MEMORY=2048

# ---- PostgreSQL --------------------------------------------------
POSTGRES_VERSION=17
POSTGRES_DB=ignition
POSTGRES_USER=ignition
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# ---- EMQX --------------------------------------------------------
EMQX_VERSION=6.2
EMQX_DASHBOARD_PASSWORD=change-me
EMQX_COOKIE=change-me
MQTT_PORT=1883
MQTT_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083

# ---- OPC UA simulator --------------------------------------------
OPC_PLC_VERSION=2.15.5
OPC_UA_PORT=50000

# ---- MQTT line simulator -----------------------------------------
MOSQUITTO_VERSION=2
MQTT_BASE_TOPIC=lab/line1
SIM_INTERVAL=2
