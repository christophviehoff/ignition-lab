              "config": {
                "expression": "\"data:image/svg+xml;charset=utf-8,\" + \"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 200' width='900' height='200' font-family='sans-serif'>\"+ \"<defs><marker id='a' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto'><path d='M2 1L8 5L2 9' fill='none' stroke='dimgray' stroke-width='1.5'/></marker></defs>\"+ \"<rect x='15' y='45' width='200' height='100' rx='8' stroke='gray' stroke-width='1.5' fill='\" + if({[MQTT Engine]fab/etch01/sv/ProcessState/value} = \"PROCESSING\", \"honeydew\", \"whitesmoke\") + \"'/>\"+ \"<text x='115' y='68' text-anchor='middle' font-size='14' font-weight='600'>Tool etch01</text>\"+ \"<text x='115' y='90' text-anchor='middle' font-size='12' fill='dimgray'>\" + {[MQTT Engine]fab/etch01/sv/ProcessState/value} + \"</text>\"+ \"<text x='115' y='112' text-anchor='middle' font-size='12' fill='dimgray'>\" + numberFormat({[MQTT Engine]fab/etch01/sv/ChamberTemp/value}, \"0.0\") + \" degC  \" + numberFormat({[MQTT Engine]fab/etch01/sv/ChamberPressure/value}, \"0.00\") + \" mTorr</text>\"+ \"<text x='115' y='132' text-anchor='middle' font-size='12' fill='dimgray'>RF \" + numberFormat({[MQTT Engine]fab/etch01/sv/RFPower/value}, \"0\") + \" W</text>\"+ \"<line x1='215' y1='95' x2='270' y2='95' stroke='dimgray' stroke-width='1.5' marker-end='url(%23a)'/>\"+ \"<text x='243' y='85' text-anchor='middle' font-size='11' fill='gray'>HSMS 5000</text>\"+ \"<rect x='272' y='45' width='190' height='100' rx='8' stroke='gray' stroke-width='1.5' fill='\" + if({[MQTT Engine]fab/etch01/status/online}, \"honeydew\", \"mistyrose\") + \"'/>\"+ \"<text x='367' y='68' text-anchor='middle' font-size='14' font-weight='600'>secsgem bridge</text>\"+ \"<text x='367' y='92' text-anchor='middle' font-size='12' fill='dimgray'>GEM host</text>\"+ \"<text x='367' y='114' text-anchor='middle' font-size='12' fill='dimgray'>\" + if({[MQTT Engine]fab/etch01/status/online}, \"online\", \"offline\") + \"</text>\"+ \"<text x='367' y='134' text-anchor='middle' font-size='12' fill='dimgray'>wafers \" + toString({[MQTT Engine]fab/etch01/sv/WaferCount/value}) + \"</text>\"+ \"<line x1='462' y1='95' x2='517' y2='95' stroke='dimgray' stroke-width='1.5' marker-end='url(%23a)'/>\"+ \"<text x='490' y='85' text-anchor='middle' font-size='11' fill='gray'>MQTT</text>\"+ \"<rect x='519' y='45' width='170' height='100' rx='8' stroke='gray' stroke-width='1.5' fill='aliceblue'/>\"+ \"<text x='604' y='68' text-anchor='middle' font-size='14' font-weight='600'>EMQX</text>\"+ \"<text x='604' y='94' text-anchor='middle' font-size='12' fill='dimgray'>fab/etch01</text>\"+ \"<text x='604' y='116' text-anchor='middle' font-size='12' fill='dimgray'>sv, event, alarm</text>\"+ \"<line x1='689' y1='95' x2='744' y2='95' stroke='dimgray' stroke-width='1.5' marker-end='url(%23a)'/>\"+ \"<text x='716' y='85' text-anchor='middle' font-size='11' fill='gray'>Engine</text>\"+ \"<rect x='746' y='45' width='140' height='100' rx='8' stroke='gray' stroke-width='1.5' fill='aliceblue'/>\"+ \"<text x='816' y='68' text-anchor='middle' font-size='14' font-weight='600'>Ignition</text>\"+ \"<text x='816' y='94' text-anchor='middle' font-size='12' fill='dimgray'>tags</text>\"+ \"<text x='816' y='116' text-anchor='middle' font-size='12' fill='dimgray'>this view</text>\"+ \"<path d='M816 145 L816 175 L115 175 L115 147' fill='none' stroke='peru' stroke-width='1.5' stroke-dasharray='5 4' marker-end='url(%23a)'/>\"+ \"<text x='465' y='193' text-anchor='middle' font-size='11' fill='peru'>remote command to S2F41</text>\"+ \"</svg>\""
